# Shopify Storefront API — required. Use the *.myshopify.com domain, never the
# custom domain. Token from the Headless channel (public Storefront access token).
SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_ACCESS_TOKEN=

# Optional. Only set at the Milestone 5 domain cutover — the host Shopify should
# serve checkout from once preciousjewels.co points at this app. See
# docs/launch-checklist.md. Leave blank until then.
SHOPIFY_CHECKOUT_DOMAIN=

# Optional. Sentry error monitoring (Milestone 5) — inert until set.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
